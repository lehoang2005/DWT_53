# ================================================================
# DWT_53 - QuestaSim regression Makefile
# Run this Makefile from: DWT_53/sim
#
# Expected project tree:
# DWT_53/
#   ├── rtl_streaming/
#   │   ├── dwt53_fwd1d_pair_stream.sv
#   │   ├── dwt53_fwd2d_stream.sv
#   │   ├── dwt53_inv2d_stream.sv
#   │   ├── dwt53_band_align.sv
#   │   ├── dwt53_checkpoint8.sv
#   │   └── dwt53_streaming_top.sv
#   ├── tb/
#   │   └── tb_*.sv
#   ├── golden_model/
#   │   └── golden_vectors/
#   │       └── <vector-set>/...
#   └── sim/
#       └── Makefile
# ================================================================

# -----------------------------
# User-selectable variables
# -----------------------------
TB_NAME      ?= tb_dwt53_streaming_top
TESTNAME     ?= random_0008x0008
VEC_SET      ?= $(TESTNAME)
WIDTH        ?= 8
HEIGHT       ?= 8
LEVEL        ?= 1
N            ?= 8
GAP_EVERY    ?= 0
RADIX        ?= decimal
MAX_CYCLES   ?=
TRACE         ?= 0

# Parameter overrides used by the selected TB.
# Override this for TBs whose parameter set differs from the top TB.
VSIM_PARAMS  ?= -GWIDTH=$(WIDTH) -GHEIGHT=$(HEIGHT)

# Runtime plusargs.  +VEC_DIR is valid for the golden-vector TBs.
PLUSARGS     ?= +VEC_DIR=$(VEC_DIR) +GAP_EVERY=$(GAP_EVERY)

# -----------------------------
# Project paths
# -----------------------------
SHELL	     := /bin/bash
RTL_DIR      := ../rtl_streaming
TB_DIR       := ../tb
VEC_ROOT     := ../golden_model/golden_vectors
VEC_DIR      := $(VEC_ROOT)/$(VEC_SET)
LOG_DIR      := log
COV_DIR      := coverage
WORK_LIB     := work

TB_FILE      := $(TB_DIR)/$(TB_NAME).sv

RTL_FILES := \
	$(RTL_DIR)/dwt53_fwd1d_pair_stream.sv \
	$(RTL_DIR)/dwt53_fwd2d_stream.sv \
	$(RTL_DIR)/dwt53_inv2d_stream.sv \
	$(RTL_DIR)/dwt53_band_align.sv \
	$(RTL_DIR)/dwt53_checkpoint8.sv \
	$(RTL_DIR)/dwt53_streaming_top.sv

# -----------------------------
# Questa / lint commands
# -----------------------------
VLIB        ?= vlib
VMAP        ?= vmap
VLOG        ?= vlog
VSIM        ?= vsim
VCOVER      ?= vcover
VERILATOR   ?= verilator

# Keep compile and runtime logs unique per TB/test.
RUN_TAG      := $(TB_NAME)_$(TESTNAME)_$(WIDTH)x$(HEIGHT)
COMPILE_LOG  := $(LOG_DIR)/$(RUN_TAG)_compile.log
RUN_LOG      := $(LOG_DIR)/$(RUN_TAG).log
UCDB         := $(RUN_TAG).ucdb

# Optional VCD generated by tb_dwt53_streaming_top when +TRACE is present.
ifeq ($(TRACE),1)
TRACE_ARG    := +TRACE
else
TRACE_ARG    :=
endif

ifneq ($(strip $(MAX_CYCLES)),)
MAXCYC_ARG   := +MAX_CYCLES=$(MAX_CYCLES)
else
MAXCYC_ARG   :=
endif

.PHONY: all all_wave all_cov drc drc_tb build build_cov run run_cov wave \
        view_cov gen_cov gen_html clean group regression small scale full \
        test_4x4 test_8x8 test_8x12 test_12x8 test_16x16 test_edges \
        test_64x64 test_64x128 test_128x256 test_256x512 \
        test_720p_random test_720p_real \
        test_fwd1d test_fwd2d_l1 test_fwd2d_l2 test_inv2d_l1 test_inv2d_l2 \
        test_checkpoint test_protocol test_c0c2 test_twoframes help check_paths

# ================================================================
# Main flow
# ================================================================
all: build run

all_wave: build run wave

all_cov: build_cov run_cov

# Verilator is optional here: use it only as an additional lint pass.
drc: check_paths
	$(VERILATOR) --lint-only --timing -Wall -Wno-fatal $(RTL_FILES)

drc_tb: check_paths
	$(VERILATOR) --lint-only --timing -Wall -Wno-fatal $(RTL_FILES) $(TB_FILE) --top-module $(TB_NAME)

check_paths:
	@test -d "$(RTL_DIR)" || (echo "ERROR: missing $(RTL_DIR)"; exit 1)
	@test -d "$(TB_DIR)"  || (echo "ERROR: missing $(TB_DIR)"; exit 1)
	@test -f "$(TB_FILE)" || (echo "ERROR: missing TB file $(TB_FILE)"; exit 1)
	@mkdir -p $(LOG_DIR)

# Compile RTL + exactly one selected SystemVerilog TB.
build: check_paths
	@echo "[BUILD] TB=$(TB_NAME) TEST=$(TESTNAME)"
	@rm -rf $(WORK_LIB)
	$(VLIB) $(WORK_LIB)
	$(VMAP) $(WORK_LIB) $(WORK_LIB)
	@set -o pipefail; $(VLOG) -sv -work $(WORK_LIB) $(RTL_FILES) $(TB_FILE) 2>&1 | tee $(COMPILE_LOG)
build_cov: check_paths
	@echo "[BUILD+COV] TB=$(TB_NAME) TEST=$(TESTNAME)"
	@rm -rf $(WORK_LIB)
	$(VLIB) $(WORK_LIB)
	$(VMAP) $(WORK_LIB) $(WORK_LIB)
	@set -o pipefail; $(VLOG) -sv +cover=bcesft -work $(WORK_LIB) $(RTL_FILES) $(TB_FILE) 2>&1 | tee $(COMPILE_LOG)
run:
	@mkdir -p $(LOG_DIR)
	@echo "[RUN] TB=$(TB_NAME) TEST=$(TESTNAME) VEC=$(VEC_DIR)"
	$(VSIM) -c -debugDB -l $(RUN_LOG) -voptargs=+acc \
		$(VSIM_PARAMS) $(WORK_LIB).$(TB_NAME) \
		$(PLUSARGS) $(TRACE_ARG) $(MAXCYC_ARG) \
		-do "log -r /*; run -all; quit -f"
	@cp $(RUN_LOG) sim.log

run_cov:
	@mkdir -p $(LOG_DIR)
	@echo "[RUN+COV] TB=$(TB_NAME) TEST=$(TESTNAME)"
	$(VSIM) -coverage -c -l $(RUN_LOG) -voptargs="+cover=bcesft +acc" \
		$(VSIM_PARAMS) $(WORK_LIB).$(TB_NAME) \
		$(PLUSARGS) $(TRACE_ARG) $(MAXCYC_ARG) \
		-do "coverage save -onexit $(UCDB); log -r /*; run -all; quit -f"
	@cp $(RUN_LOG) sim.log

# Open the WLF produced by the most recent run and recursively add TB signals.
wave:
	$(VSIM) -i -view vsim.wlf \
		-do "add wave -r sim:/$(TB_NAME)/*; radix -$(RADIX)" &

# ================================================================
# Coverage
# ================================================================
view_cov:
	$(VSIM) -gui -viewcov DWT_53.ucdb &

gen_cov:
	mkdir -p $(COV_DIR)
	$(VCOVER) merge DWT_53.ucdb *.ucdb
	$(VCOVER) report DWT_53.ucdb -output $(COV_DIR)/summary_report.txt
	$(VCOVER) report -zeros -details -code bcesft -annotate -All -codeAll \
		DWT_53.ucdb -output $(COV_DIR)/detail_report.txt

gen_html:
	mkdir -p $(COV_DIR)
	$(VCOVER) merge DWT_53.ucdb *.ucdb
	$(VCOVER) report -zeros -details -code bcesft -annotate -testhitdataAll \
		-html DWT_53.ucdb

# ================================================================
# Directed / unit TB targets
# ================================================================
# 1D vector directory must contain input_hex.txt, L_hex.txt, H_hex.txt.
test_fwd1d:
	$(MAKE) all TB_NAME=tb_dwt53_fwd1d_pair_stream TESTNAME=$(TESTNAME) \
		N=$(N) VSIM_PARAMS="-GN=$(N)" \
		PLUSARGS="+VEC_DIR=$(VEC_DIR) +GAP_EVERY=$(GAP_EVERY)"

# LEVEL=1 consumes Y8 and checks C1.
test_fwd2d_l1:
	$(MAKE) all TB_NAME=tb_dwt53_fwd2d_stream TESTNAME=$(TESTNAME) \
		WIDTH=$(WIDTH) HEIGHT=$(HEIGHT) LEVEL=1 \
		VSIM_PARAMS="-GWIDTH=$(WIDTH) -GHEIGHT=$(HEIGHT) -GLEVEL=1" \
		PLUSARGS="+VEC_DIR=$(VEC_DIR) +GAP_EVERY=$(GAP_EVERY)"

# LEVEL=2 consumes LL1 and checks the L2 quadrant of C2.
test_fwd2d_l2:
	$(MAKE) all TB_NAME=tb_dwt53_fwd2d_stream TESTNAME=$(TESTNAME) \
		WIDTH=$(WIDTH) HEIGHT=$(HEIGHT) LEVEL=2 \
		VSIM_PARAMS="-GWIDTH=$(WIDTH) -GHEIGHT=$(HEIGHT) -GLEVEL=2" \
		PLUSARGS="+VEC_DIR=$(VEC_DIR) +GAP_EVERY=$(GAP_EVERY)"

test_inv2d_l1:
	$(MAKE) all TB_NAME=tb_dwt53_inv2d_stream TESTNAME=$(TESTNAME) \
		WIDTH=$(WIDTH) HEIGHT=$(HEIGHT) LEVEL=1 \
		VSIM_PARAMS="-GWIDTH=$(WIDTH) -GHEIGHT=$(HEIGHT) -GLEVEL=1" \
		PLUSARGS="+VEC_DIR=$(VEC_DIR)"

test_inv2d_l2:
	$(MAKE) all TB_NAME=tb_dwt53_inv2d_stream TESTNAME=$(TESTNAME) \
		WIDTH=$(WIDTH) HEIGHT=$(HEIGHT) LEVEL=2 \
		VSIM_PARAMS="-GWIDTH=$(WIDTH) -GHEIGHT=$(HEIGHT) -GLEVEL=2" \
		PLUSARGS="+VEC_DIR=$(VEC_DIR)"

test_checkpoint:
	$(MAKE) all TB_NAME=tb_dwt53_checkpoint8 TESTNAME=checkpoint \
		VSIM_PARAMS="" PLUSARGS=""

test_protocol:
	$(MAKE) all TB_NAME=tb_dwt53_streaming_protocol TESTNAME=protocol \
		WIDTH=8 HEIGHT=8 VSIM_PARAMS="-GWIDTH=8 -GHEIGHT=8" PLUSARGS=""

test_c0c2:
	$(MAKE) all TB_NAME=tb_dwt53_streaming_c0c2 TESTNAME=random_0008x0008 \
		WIDTH=8 HEIGHT=8 VEC_SET=random_0008x0008 \
		VSIM_PARAMS="-GWIDTH=8 -GHEIGHT=8" \
		PLUSARGS="+VEC_DIR=$(VEC_ROOT)/random_0008x0008"

test_twoframes:
	$(MAKE) all TB_NAME=tb_dwt53_streaming_two_frames TESTNAME=random_0008x0008 \
		WIDTH=8 HEIGHT=8 VEC_SET=random_0008x0008 \
		VSIM_PARAMS="-GWIDTH=8 -GHEIGHT=8" \
		PLUSARGS="+VEC_DIR=$(VEC_ROOT)/random_0008x0008"

# ================================================================
# Full-top golden-vector ladder
# Golden generator names directories as ROWS x COLS.
# WIDTH is therefore the second number and HEIGHT is the first.
# ================================================================
test_4x4:
	$(MAKE) all TESTNAME=canonical_0004x0004 VEC_SET=canonical_0004x0004 WIDTH=4 HEIGHT=4

test_8x8:
	$(MAKE) all TESTNAME=random_0008x0008 VEC_SET=random_0008x0008 WIDTH=8 HEIGHT=8

test_8x12:
	$(MAKE) all TESTNAME=random_0008x0012 VEC_SET=random_0008x0012 WIDTH=12 HEIGHT=8

test_12x8:
	$(MAKE) all TESTNAME=random_0012x0008 VEC_SET=random_0012x0008 WIDTH=8 HEIGHT=12

test_16x16:
	$(MAKE) all TESTNAME=random_0016x0016 VEC_SET=random_0016x0016 WIDTH=16 HEIGHT=16

test_edges:
	$(MAKE) all TESTNAME=edges_0016x0016 VEC_SET=edges_0016x0016 WIDTH=16 HEIGHT=16

test_64x64:
	$(MAKE) all TESTNAME=random_0064x0064 VEC_SET=random_0064x0064 WIDTH=64 HEIGHT=64

test_64x128:
	$(MAKE) all TESTNAME=random_0064x0128 VEC_SET=random_0064x0128 WIDTH=128 HEIGHT=64

test_128x256:
	$(MAKE) all TESTNAME=random_0128x0256 VEC_SET=random_0128x0256 WIDTH=256 HEIGHT=128

test_256x512:
	$(MAKE) all TESTNAME=random_0256x0512 VEC_SET=random_0256x0512 WIDTH=512 HEIGHT=256

test_720p_random:
	$(MAKE) all TESTNAME=random_0720x1280 VEC_SET=random_0720x1280 WIDTH=1280 HEIGHT=720

test_720p_real:
	$(MAKE) all TESTNAME=real_0720x1280 VEC_SET=real_0720x1280 WIDTH=1280 HEIGHT=720

small:
	$(MAKE) test_8x8
	$(MAKE) test_8x12
	$(MAKE) test_12x8
	$(MAKE) test_16x16
	$(MAKE) test_edges
	$(MAKE) test_64x64

scale:
	$(MAKE) test_64x128
	$(MAKE) test_128x256
	$(MAKE) test_256x512

full:
	$(MAKE) test_720p_random
	$(MAKE) test_720p_real

# Same role as "group" in the old APB_timer Makefile.
group: regression

# 4x4 is intentionally separate until the current inverse-L2 1x1 corner case
# is supported by rtl_streaming.
regression:
	$(MAKE) test_checkpoint
	$(MAKE) test_protocol
	$(MAKE) test_c0c2
	$(MAKE) test_twoframes
	$(MAKE) small
	$(MAKE) scale
	$(MAKE) full

# ================================================================
# Cleanup / help
# ================================================================
clean:
	rm -rf $(WORK_LIB)
	rm -rf vsim.dbg
	rm -rf *.ini
	rm -rf *.log
	rm -rf *.wlf
	rm -rf transcript
	rm -rf *.ucdb
	rm -rf streaming_top.vcd
	rm -rf $(LOG_DIR)
	rm -rf $(COV_DIR)

help:
	@echo ""
	@echo "============================================================"
	@echo " DWT_53 QuestaSim Makefile  (run from DWT_53/sim)"
	@echo "============================================================"
	@echo " make clean           : remove compiled/simulation data"
	@echo " make build           : compile RTL + selected SystemVerilog TB"
	@echo " make run             : run selected TB in batch mode"
	@echo " make all             : build + run (default top 8x8)"
	@echo " make all_wave        : build + run + open Questa waveform"
	@echo " make build_cov       : compile with code coverage"
	@echo " make run_cov         : run and save UCDB coverage"
	@echo " make all_cov         : build_cov + run_cov"
	@echo " make wave            : open latest vsim.wlf"
	@echo " make gen_cov         : merge UCDB + text coverage reports"
	@echo " make gen_html        : merge UCDB + HTML coverage report"
	@echo " make drc             : optional Verilator RTL lint"
	@echo ""
	@echo " Golden full-top tests:"
	@echo " make test_8x8"
	@echo " make test_8x12"
	@echo " make test_12x8"
	@echo " make test_16x16"
	@echo " make test_edges"
	@echo " make test_64x64"
	@echo " make scale"
	@echo " make full            : random + natural 1280x720"
	@echo " make regression      : complete current regression ladder"
	@echo ""
	@echo " Unit tests:"
	@echo " make test_checkpoint"
	@echo " make test_protocol"
	@echo " make test_c0c2"
	@echo " make test_twoframes"
	@echo " make test_fwd1d TESTNAME=<1d-set> N=<N>"
	@echo " make test_fwd2d_l1 TESTNAME=random_0008x0008 WIDTH=8 HEIGHT=8"
	@echo " make test_fwd2d_l2 TESTNAME=random_0008x0008 WIDTH=8 HEIGHT=8"
	@echo " make test_inv2d_l1 TESTNAME=random_0008x0008 WIDTH=8 HEIGHT=8"
	@echo " make test_inv2d_l2 TESTNAME=random_0008x0008 WIDTH=8 HEIGHT=8"
	@echo "============================================================"
